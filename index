<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Stand de tir</title>
<style>
*{box-sizing:border-box}
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{margin:0;min-height:100vh;background:#1b241b;color:#f2f2f2;font-family:system-ui,sans-serif;display:flex;flex-direction:column;align-items:center}
#hud{width:100%;max-width:900px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;padding:10px 12px;font-size:15px;font-weight:600}
canvas{width:100%;max-width:900px;height:auto;display:block;border-radius:10px;cursor:none;touch-action:none}
#weapons{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;padding:10px}
button{padding:9px 12px;border:0;border-radius:8px;background:#3a4a3a;color:#fff;font-size:15px;cursor:pointer}
button:disabled{opacity:.4;cursor:not-allowed}
button.active{background:#e0a100;color:#111;font-weight:700}
#overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:24px;text-align:center}
#overlay.hidden{display:none}
#overlay h1{margin:0}
#overlay p{max-width:480px;margin:0;line-height:1.5}
#skins{display:flex;flex-wrap:wrap;gap:6px;justify-content:center}
#overlay button.big{font-size:18px;padding:12px 26px}
#shop{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;padding:6px 10px;max-width:900px}
#shop button{font-size:13px;padding:7px 10px}
</style>
</head>
<body>
<div id="hud"><span id="score"></span><span id="time"></span><span id="ammo"></span></div>
<canvas id="c"></canvas>
<div id="weapons"></div>
<div id="tokens" style="font-weight:700;padding:4px"></div>
<div id="shop"></div>
<div id="shooters" style="display:flex;gap:6px;flex-wrap:wrap;justify-content:center;padding:4px"></div>
<div id="themes" style="display:flex;gap:6px;flex-wrap:wrap;justify-content:center;padding:4px"></div>
<div id="overlay">
  <h1 id="title">Stand de tir</h1>
  <p id="desc"></p>
  <div id="skins"></div>
  <button id="go" class="big">Commencer</button>
</div>
<script>
const TAU=Math.PI*2;
const cv=document.getElementById('c'),ctx=cv.getContext('2d');
const W=900,H=520;cv.width=W;cv.height=H;
const GUN={x:W/2,y:H-30};

const WEAPONS=[
  {name:'Pistolet',price:0,cool:350,ammo:Infinity,pellets:1,spread:0.01,dmg:1,color:'#ccc'},
  {name:'Revolver',price:10,cool:500,ammo:12,pellets:1,spread:0.005,dmg:2,color:'#999'},
  {name:'Fusil à pompe',price:20,cool:800,ammo:6,pellets:6,spread:0.12,dmg:1,color:'#a0522d'},
  {name:'Mitraillette',price:30,cool:90,ammo:40,pellets:1,spread:0.06,dmg:1,color:'#f55'},
  {name:"Fusil d'assaut",price:45,cool:150,ammo:30,pellets:1,spread:0.03,dmg:1,color:'#6a6'},
  {name:'Arbalète',price:55,cool:900,ammo:8,pellets:1,spread:0,dmg:3,color:'#c84'},
  {name:'Sniper',price:60,cool:1100,ammo:5,pellets:1,spread:0,dmg:3,color:'#3cf'},
  {name:'Lance-grenades',price:75,cool:1000,ammo:4,pellets:1,spread:0.02,dmg:1,splash:70,color:'#8a5'},
  {name:'Lance-roquette',price:100,cool:1300,ammo:3,pellets:1,spread:0,dmg:2,splash:120,color:'#e74'},
  {name:'Mini-gun',price:150,cool:60,ammo:150,pellets:1,spread:0.08,dmg:1,color:'#fc3'},
  {name:'Canon laser',price:200,cool:250,ammo:20,pellets:1,spread:0,dmg:5,color:'#f0f'}
];
const KINDS={
  cible:{r:20,pts:1,hp:1,life:2200},
  canard:{r:22,pts:3,hp:1,life:Infinity},
  blindee:{r:28,pts:5,hp:3,life:4000},
  caisse:{r:18,pts:0,hp:1,life:2600}
};
const LEVELS=[
  {label:'Facile',goal:10,time:40,types:['cible'],spawn:900,speed:1,max:5},
  {label:'Canards',goal:20,time:40,types:['cible','canard'],spawn:800,speed:1.2,max:6},
  {label:'Blindées',goal:35,time:45,types:['cible','canard','blindee'],spawn:700,speed:1.4,max:7},
  {label:'Caisses',goal:50,time:45,types:['cible','canard','blindee','caisse'],spawn:600,speed:1.6,max:7},
  {label:'Expert',goal:70,time:50,types:['cible','canard','blindee','caisse'],spawn:450,speed:1.9,max:9}
];
// Skins : 'lvl' = débloqué en finissant ce niveau (0 = dès le début), 'price' = achetable avec des jetons
const THEMES=[
  {name:'Classique',lvl:0,sky:['#8fc3e6','#c9e4b0','#6b9a4f'],ground:'#5a4a32',ring:'#d33',duck:'#ffd21f'},
  {name:'Nuit',lvl:1,sky:['#0b1026','#243b6b','#1a2a18'],ground:'#2a2a2a',ring:'#0ff',duck:'#ffe066'},
  {name:'Désert',lvl:2,sky:['#f7c873','#fbe3a8','#d9a35a'],ground:'#b98a4a',ring:'#c0392b',duck:'#8d5524'},
  {name:'Neige',lvl:3,sky:['#cfe8f7','#f2fafd','#e8f1f5'],ground:'#ffffff',ring:'#2c7be5',duck:'#ff7b00'},
  {name:'Montagne',price:40,sky:['#6fa8dc','#b7d7f2','#e8f1f8'],ground:'#5d6b4a',peaks:'#8a8f96',ring:'#e67e22',duck:'#f1c40f'},
  {name:'Russie (hiver)',price:50,sky:['#9fb8c9','#dfe9f0','#eef3f6'],ground:'#ffffff',peaks:'#c9d6e0',ring:'#c0392b',duck:'#2c3e50'},
  {name:'Volcan',price:60,sky:['#2a0a04','#7a2a0a','#ff6b00'],ground:'#2b1b17',peaks:'#1a0f0c',ring:'#ffcc00',duck:'#ffb347'},
  {name:'Enfer rouge',price:80,sky:['#3a0a0a','#8b1a1a','#4a1010'],ground:'#5a1f1f',peaks:'#2e0b0b',ring:'#ffcc00',duck:'#ff8c00'},
  {name:'Everest',price:120,sky:['#0b1a33','#3c5a80','#e8f3ff'],ground:'#f5fbff',peaks:'#dfe9f2',ring:'#e74c3c',duck:'#ffd21f'}
];

let state='menu',level=0,maxLevel=0,theme=0,total=0,score=0,timeLeft=40;
let tokens=0,lastTok=-1;
let inv={0:Infinity},cur=0,targets=[],tracers=[],pops=[];
let mouse={x:W/2,y:H/2},lastShot=0,spawnT=0,holding=false,last=0;

const $=id=>document.getElementById(id);
const wBox=$('weapons');
const btns=WEAPONS.map((w,i)=>{
  const b=document.createElement('button');
  b.onclick=()=>{if(inv[i]>0)cur=i;};
  wBox.appendChild(b);
  return b;
});

function spawn(){
  const L=LEVELS[level];
  const type=L.types[Math.floor(Math.random()*L.types.length)];
  const k=KINDS[type];
  const t={type,r:k.r,pts:k.pts,hp:k.hp,life:k.life*(1-level*0.08),x:0,y:0,vx:0,flash:0,dead:false};
  if(type==='canard'){
    t.vx=(Math.random()<.5?1:-1)*(1.5+Math.random()*1.5)*L.speed;
    t.x=t.vx>0?-30:W+30;
    t.y=110+Math.random()*120;
  }else{
    t.x=70+Math.random()*(W-140);
    t.y=(type==='blindee'||type==='caisse')?150+Math.random()*(H-260):120+Math.random()*(H-260);
  }
  targets.push(t);
}

function addPop(x,y,text,color){pops.push({x,y,text,color,life:800});}

function hit(t,dmg){
  if(t.dead)return;
  t.hp-=dmg;
  if(t.hp>0){t.flash=150;return;}
  t.dead=true;
  score+=t.pts;
  const gain=t.type==='caisse'?5:t.pts;
  tokens+=gain;
  addPop(t.x,t.y-20,'+'+gain+' jeton'+(gain>1?'s':''),t.type==='caisse'?'#ffd34d':'#fff');
}

function shoot(now){
  if(state!=='play'||now-lastShot<WEAPONS[cur].cool)return;
  if(mouse.y>GUN.y-40)return;
  if(!(inv[cur]>0))return;
  const w=WEAPONS[cur];
  lastShot=now;
  inv[cur]--;
  queueSave();
  if(inv[cur]===0)cur=0;
  const base=Math.atan2(mouse.y-GUN.y,mouse.x-GUN.x);
  for(let p=0;p<w.pellets;p++){
    const a=base+(Math.random()-.5)*2*w.spread;
    const dx=Math.cos(a),dy=Math.sin(a);
    let best=null,bp=Infinity;
    for(const t of targets){
      if(t.dead)continue;
      const vx=t.x-GUN.x,vy=t.y-GUN.y;
      const pr=vx*dx+vy*dy;
      if(pr<0||pr>=bp)continue;
      if(Math.abs(vx*dy-vy*dx)<t.r){best=t;bp=pr;}
    }
    const L=best?bp:1200;
    tracers.push({x2:GUN.x+dx*L,y2:GUN.y+dy*L,life:90,color:w.color});
    if(best){
      hit(best,w.dmg);
      if(w.splash)for(const t of targets)if(t!==best&&!t.dead&&Math.hypot(t.x-best.x,t.y-best.y)<w.splash)hit(t,w.dmg);
    }
  }
}

function beginLevel(){
  const L=LEVELS[level];
  score=0;timeLeft=L.time;
  targets=[];tracers=[];pops=[];spawnT=0;lastShot=0;
  state='play';
  $('overlay').classList.add('hidden');
}

function newGame(){
  level=0;total=0;cur=0;
  beginLevel();
}

function winLevel(){
  total+=score;
  maxLevel=Math.max(maxLevel,level+1);
  queueSave();
  if(level===LEVELS.length-1){
    state='levelup';
    showOverlay('Niveau Expert réussi !','Score total : '+total+' points. La partie continue sans fin.','Continuer');
  }else{
    state='levelup';
    const N=LEVELS[level+1];
    showOverlay('Niveau '+(level+1)+' réussi !','Score : '+score+' / '+LEVELS[level].goal+'. Prochain niveau : '+(level+2)+' ('+N.label+'), objectif '+N.goal+' points en '+N.time+' s.','Niveau suivant');
  }
}

function loseLevel(){
  total+=score;
  beginLevel();
  addPop(W/2,H/2-60,'Temps écoulé, on repart !','#ffd34d');
}

function update(dt){
  const L=LEVELS[level];
  timeLeft-=dt/1000;
  if(score>=L.goal){winLevel();return;}
  if(timeLeft<=0){timeLeft=0;score<L.goal?loseLevel():winLevel();return;}
  spawnT-=dt;
  if(spawnT<=0){
    if(targets.filter(t=>!t.dead).length<L.max)spawn();
    spawnT=L.spawn*(0.7+Math.random()*0.6);
  }
  for(const t of targets){
    t.x+=t.vx*dt/16;
    t.life-=dt;
    if(t.flash>0)t.flash-=dt;
    if(t.life<=0||t.x<-60||t.x>W+60)t.dead=true;
  }
  targets=targets.filter(t=>!t.dead);
  tracers.forEach(t=>t.life-=dt);
  tracers=tracers.filter(t=>t.life>0);
  pops.forEach(p=>{p.life-=dt;p.y-=dt*0.05;});
  pops=pops.filter(p=>p.life>0);
  if(holding)shoot(performance.now());
}

function drawTarget(t,T){
  ctx.save();
  ctx.translate(t.x,t.y);
  switch(t.type){
    case 'cible':
      ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(0,0,t.r,0,TAU);ctx.fill();
      ctx.fillStyle=T.ring;ctx.beginPath();ctx.arc(0,0,t.r*.66,0,TAU);ctx.fill();
      ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(0,0,t.r*.33,0,TAU);ctx.fill();
      break;
    case 'canard':
      ctx.fillStyle=T.duck;
      ctx.beginPath();ctx.ellipse(0,0,t.r*1.1,t.r*.6,0,0,TAU);ctx.fill();
      ctx.beginPath();ctx.arc(t.vx>0?t.r*.8:-t.r*.8,-t.r*.5,t.r*.45,0,TAU);ctx.fill();
      break;
    case 'blindee':
      ctx.fillStyle='#666';ctx.beginPath();ctx.arc(0,0,t.r,0,TAU);ctx.fill();
      ctx.strokeStyle='#bbb';ctx.lineWidth=4;ctx.stroke();
      ctx.fillStyle='#fff';ctx.font='bold 14px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText(t.hp,0,0);
      break;
    case 'caisse':
      ctx.fillStyle='#8b5a2b';ctx.fillRect(-t.r,-t.r,t.r*2,t.r*2);
      ctx.strokeStyle='#4a2e12';ctx.lineWidth=2;ctx.strokeRect(-t.r,-t.r,t.r*2,t.r*2);
      ctx.fillStyle='#ffd34d';ctx.font='bold 20px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText('?',0,1);
      break;
  }
  if(t.flash>0){
    ctx.globalAlpha=.6;ctx.fillStyle='#fff';
    ctx.beginPath();ctx.arc(0,0,t.r,0,TAU);ctx.fill();
    ctx.globalAlpha=1;
  }
  ctx.restore();
}

function draw(){
  const T=THEMES[theme];
  const g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,T.sky[0]);g.addColorStop(.55,T.sky[1]);g.addColorStop(1,T.sky[2]);
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  if(T.peaks){
    ctx.fillStyle=T.peaks;ctx.beginPath();
    ctx.moveTo(0,H-70);ctx.lineTo(150,250);ctx.lineTo(300,H-70);ctx.lineTo(480,180);
    ctx.lineTo(680,H-70);ctx.lineTo(820,300);ctx.lineTo(W,H-70);ctx.closePath();ctx.fill();
  }
  ctx.fillStyle=T.ground;ctx.fillRect(0,H-70,W,70);
  for(const t of targets)drawTarget(t,T);
  for(const t of tracers){
    ctx.globalAlpha=Math.max(0,t.life/90);
    ctx.strokeStyle=t.color;ctx.lineWidth=2;
    ctx.beginPath();ctx.moveTo(GUN.x,GUN.y);ctx.lineTo(t.x2,t.y2);ctx.stroke();
  }
  ctx.globalAlpha=1;
  drawShooter(shooter);
  const w=WEAPONS[cur],a=Math.atan2(mouse.y-GUN.y,mouse.x-GUN.x);
  ctx.save();
  ctx.translate(GUN.x,GUN.y);ctx.rotate(a);
  ctx.fillStyle='#222';ctx.fillRect(0,-6,60,12);
  ctx.fillStyle=w.color;ctx.fillRect(0,-4,46,8);
  ctx.restore();
  ctx.strokeStyle='#111';ctx.lineWidth=2;
  ctx.beginPath();
  ctx.arc(mouse.x,mouse.y,12,0,TAU);
  ctx.moveTo(mouse.x-18,mouse.y);ctx.lineTo(mouse.x+18,mouse.y);
  ctx.moveTo(mouse.x,mouse.y-18);ctx.lineTo(mouse.x,mouse.y+18);
  ctx.stroke();
  ctx.font='bold 16px system-ui';ctx.textAlign='center';ctx.textBaseline='alphabetic';
  for(const p of pops){
    ctx.globalAlpha=Math.max(0,p.life/800);
    ctx.fillStyle=p.color;ctx.fillText(p.text,p.x,p.y);
  }
  ctx.globalAlpha=1;
}

function updateHUD(){
  if(tokens!==lastTok)renderShop();
  const L=LEVELS[level];
  $('score').textContent='Niveau '+(level+1)+' · '+L.label+' · Score '+score+' / '+L.goal;
  $('time').textContent='Temps : '+Math.ceil(timeLeft)+' s · Total : '+total;
  const ammoTxt=v=>v===Infinity?'∞':v;
  $('ammo').textContent=WEAPONS[cur].name+' : '+ammoTxt(inv[cur]);
  btns.forEach((b,i)=>{
    b.textContent=WEAPONS[i].name+(inv[i]===undefined?' 🔒':' ('+ammoTxt(inv[i])+')');
    b.disabled=!(inv[i]>0);
    b.classList.toggle('active',i===cur);
  });
}

let shooter=0;
const SHOOTERS=[
  {n:'Soldat',body:'#4b5a2f',skin:'#e0b48a',hair:'#222',hat:'#3d4a25'},
  {n:'Président',body:'#1e2a44',skin:'#f0c39a',hair:'#d9c27a',tie:'#a01c1c'},
  {n:'Cowboy',body:'#8b5a2b',skin:'#e6b98c',hair:'#4a2e12',hat:'#6b4423'},
  {n:'Ninja',body:'#111',skin:'#333',hair:'#111',mask:true}
];
function drawShooter(i){
  const s=SHOOTERS[i],x=GUN.x;
  ctx.save();
  ctx.fillStyle=s.body;ctx.fillRect(x-22,468,44,60);
  if(s.tie){ctx.fillStyle=s.tie;ctx.fillRect(x-3,470,6,22);}
  ctx.fillStyle=s.skin;ctx.beginPath();ctx.arc(x,455,14,0,TAU);ctx.fill();
  ctx.fillStyle=s.hair;ctx.beginPath();ctx.arc(x,449,14,Math.PI,TAU);ctx.fill();
  if(s.hat){ctx.fillStyle=s.hat;ctx.fillRect(x-22,442,44,6);ctx.fillRect(x-12,430,24,12);}
  if(s.mask){ctx.fillStyle='#111';ctx.fillRect(x-14,457,28,8);}
  ctx.strokeStyle=s.body;ctx.lineWidth=9;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(x-16,478);ctx.lineTo(x+6,488);ctx.stroke();
  ctx.restore();
}
function renderShooters(){
  queueSave();
  const box=$('shooters');
  box.innerHTML='';
  SHOOTERS.forEach((s,i)=>{
    const b=document.createElement('button');
    b.textContent=s.n;
    b.className=i===shooter?'active':'';
    b.onclick=()=>{shooter=i;renderShooters();};
    box.appendChild(b);
  });
}

// Sauvegarde : chaque joueur a sa propre progression (data/users/<id>/progress)
let saveDoc=null,saveT=0,loaded=false;
async function initSave(){
  try{
    const dbNs=await window.claude?.use('db'),us=await window.claude?.use('user');
    if(!dbNs||!us)return;
    const uid=await us.id();
    saveDoc=dbNs.collection('data/users/'+uid).doc('progress');
    const snap=await saveDoc.get();
    if(snap.exists){
      const d=snap.data()||{};
      tokens=d.tokens|0;
      bought=Array.isArray(d.bought)?d.bought:[0];
      maxLevel=d.maxLevel|0;
      theme=d.theme|0;
      shooter=d.shooter|0;
      if(d.inv){inv={};for(const k in d.inv)inv[k]=d.inv[k]===-1?Infinity:d.inv[k];}
    }
    loaded=true;
    lastTok=-1;
    renderShooters();
  }catch(e){console.warn('Sauvegarde indisponible',e);}
}
function queueSave(){
  if(!loaded)return;
  clearTimeout(saveT);
  saveT=setTimeout(saveProgress,800);
}
function saveProgress(){
  if(!saveDoc)return;
  const invOut={};
  for(const k in inv)invOut[k]=inv[k]===Infinity?-1:inv[k];
  saveDoc.set({tokens,bought,maxLevel,theme,shooter,inv:invOut}).catch(()=>{});
}

function buy(i){
  const w=WEAPONS[i];
  if(i===0||tokens<w.price)return;
  tokens-=w.price;
  inv[i]=w.ammo;
  cur=i;
  renderShop();
}

function renderShop(){
  lastTok=tokens;
  renderSkins();
  $('tokens').textContent='Jetons : '+tokens;
  const box=$('shop');
  box.innerHTML='';
  WEAPONS.forEach((w,i)=>{
    const b=document.createElement('button');
    const own=inv[i]!==undefined;
    const ammo=own?' · munitions '+(inv[i]===Infinity?'∞':inv[i]):'';
    b.textContent=w.name+' · '+w.price+' jetons'+ammo;
    b.disabled=i===0||tokens<w.price;
    b.onclick=()=>buy(i);
    box.appendChild(b);
  });
}

let bought=[0];
function themeOwned(i){
  const t=THEMES[i];
  return bought.includes(i)||(t.lvl!==undefined&&t.lvl<=maxLevel);
}
function buyTheme(i){
  const t=THEMES[i];
  if(!themeOwned(i)&&tokens>=t.price){tokens-=t.price;bought.push(i);}
  if(themeOwned(i))theme=i;
  renderShop();
  renderSkins();
}
function renderSkins(){
  queueSave();
  for(const id of ['skins','themes']){
    const box=$(id);
    box.innerHTML='';
    THEMES.forEach((t,i)=>{
      const b=document.createElement('button');
      const own=themeOwned(i);
      if(own)b.textContent=t.name;
      else if(t.price!==undefined)b.textContent=t.name+' · '+t.price+' jetons';
      else b.textContent=t.name+' · après le niveau '+t.lvl;
      b.disabled=!own&&(t.price===undefined||tokens<t.price);
      b.className=i===theme?'active':'';
      b.onclick=()=>own?(theme=i,renderSkins()):buyTheme(i);
      box.appendChild(b);
    });
  }
}

function showOverlay(title,desc,btn){
  $('title').textContent=title;
  $('desc').textContent=desc;
  $('go').textContent=btn;
  renderSkins();
  $('overlay').classList.remove('hidden');
}

function setMouse(e){
  const r=cv.getBoundingClientRect();
  mouse.x=(e.clientX-r.left)*W/r.width;
  mouse.y=(e.clientY-r.top)*H/r.height;
}

cv.addEventListener('pointermove',setMouse);
cv.addEventListener('pointerdown',e=>{setMouse(e);holding=true;shoot(performance.now());});
window.addEventListener('pointerup',()=>{holding=false;});
window.addEventListener('keydown',e=>{
  if(e.key>='1'&&e.key<='4'){const i=+e.key-1;if(inv[i]>0)cur=i;}
  if(e.code==='Space'){e.preventDefault();shoot(performance.now());}
});

$('go').onclick=()=>{
  if(state==='levelup'){level=Math.min(level+1,LEVELS.length-1);beginLevel();}
  else if(state==='end'){beginLevel();}
  else newGame();
};

function frame(now){
  const dt=Math.min(50,now-(last||now));
  last=now;
  if(state==='play')update(dt);
  draw();
  updateHUD();
  requestAnimationFrame(frame);
}

